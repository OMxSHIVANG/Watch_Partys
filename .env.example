# Server Port (optional, defaults to 3000; cloud hosts set PORT automatically)
PORT=3000

# Client origin URL(s) for CORS (comma-separated for multiple, e.g. https://yourdomain.com)
FRONTEND_URL=http://localhost:5173

# Secret key for signing JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb://127.0.0.1:27017/watchparty

# Google OAuth 2.0 Credentials (Backend & Frontend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Storage Configuration (Optional, for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
